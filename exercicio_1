#include <stdio.h>

int main() {
    int i;
    float consumo, total = 0;
//total se omeça em zero, porque ainda nenhum morador foi lido. Já consumo guarda apenas o valor d0 morador da vez, e é sobrescrito a cada repetição.//

    for (i = 1; i <= 5; i++) {
        printf("Consumo mensal do morador %d (m3): ", i);
        scanf("%f", &consumo);
        total += consumo;
//Dentro d0 for, essa linha acrescenta o consumo d0 morador atual à soma. É o mesmo que total = total + consumo.//

        if (consumo <= 20) {
            printf("Morador %d: dentro da media.\n", i);
        } else {
            printf("Morador %d: acima da media.\n", i);
        }
    }

    printf("Consumo medio geral: %.2f m3\n", total / 5);

    return 0;
}
