#include <stdio.h>

int main() {
    int i;
    float nota, soma = 0, media;

    for (i = 1; i <= 10; i++) {
        printf("Nota do cliente %d (0 a 10): ", i);
        scanf("%f", &nota);

        while (nota < 0 || nota > 10) {
            printf("Nota invalida! Digite entre 0 e 10: ");
            scanf("%f", &nota);
        }

        soma += nota;
    }

    media = soma / 10;
    printf("Media geral: %.2f\n", media);

    if (media < 7) {
        printf("ALERTA: a media de atendimento esta abaixo de 7!\n");
    }

    return 0;
}
